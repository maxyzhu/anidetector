# Copy to .env and adjust. .env is gitignored.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=anidetector
POSTGRES_PASSWORD=anidetector
POSTGRES_DB=anidetector

REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# auto picks cuda, then mps, then cpu, at the moment a model is loaded.
# Pin it to cpu/cuda/mps to override the probe.
TORCH_DEVICE=auto
